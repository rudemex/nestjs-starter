{
  "name": "nestjs-starter",
  "version": "1.0.0",
  "description": "NestJS Starter - Server",
  "author": {
    "name": "Maximiliano \"Mex\" Delgado",
    "email": "mdelgado@tresdoce.com.ar",
    "url": "https://rudemex.github.io/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rudemex/nestjs-starter.git"
  },
  "bugs": {
    "url": "https://github.com/rudemex/nestjs-starter/issues"
  },
  "homepage": "https://github.com/rudemex/nestjs-starter#readme",
  "private": true,
  "license": "MIT",
  "scripts": {
    "clean": "rimraf coverage dist node_modules junit.xml test-report.xml yarn.lock package-lock.json",
    "build": "cross-env NODE_ENV=build nest build",
    "start": "cross-env NODE_ENV=production node dist/main.js",
    "start:dev": "cross-env NODE_ENV=dev nest start --watch",
    "start:debug": "cross-env NODE_ENV=dev nest start --debug --watch",
    "lint": "oxlint --type-aware --fix src test",
    "lint:check": "oxlint --type-aware src test",
    "format": "prettier --write '{src,test,fixtures}/**/*.{ts,js,json,json5,jsonc,yml,yaml,md,mdx}'",
    "format:check": "prettier --check '{src,test,fixtures}/**/*.{ts,js,json,json5,jsonc,yml,yaml,md,mdx}'",
    "lint:format:check": "yarn lint:check && yarn format:check",
    "pre-commit": "lint-staged",
    "test": "vitest run --coverage",
    "test:husky": "vitest run --coverage",
    "test:watch": "vitest",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "release": "standard-version",
    "prepare": "husky"
  },
  "prettier": {
    "semi": true,
    "tabWidth": 2,
    "singleQuote": true,
    "printWidth": 100,
    "trailingComma": "all"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{ts,js}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,json5,jsonc,yml,yaml,md,mdx}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "@tresdoce-nestjs-toolkit/archetype": "^3.0.0",
    "@tresdoce-nestjs-toolkit/http-client": "^3.0.0",
    "@tresdoce-nestjs-toolkit/paas": "^3.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cross-env": "^10.1.0",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@tresdoce-nestjs-toolkit/commons": "^2.0.0",
    "@tresdoce-nestjs-toolkit/test-utils": "^4.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "standard-version": "^9.5.0",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "type": "module"
}
